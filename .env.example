# LLM Provider: "anthropic" (what runs) | "openai"
LLM_PROVIDER=anthropic

# OpenAI
OPENAI_API_KEY=sk-xxx
CHAT_MODEL_OPENAI=gpt-4.1-mini
SUMMARY_MODEL_OPENAI=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
CHAT_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
# Required for Claude 4.6+ chat models (they reject temperature): low | medium | high | xhigh | max
CHAT_EFFORT_ANTHROPIC=
# A second model for worries, with its effort (for example claude-sonnet-5-5 and high). Unset: the chat model answers everything.
WORRIES_MODEL_ANTHROPIC=
WORRIES_EFFORT_ANTHROPIC=
SUMMARY_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
# Backup when Anthropic fails: the same model on Amazon Bedrock, Japan only. Off unless set
# BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# LINE
LINE_CHANNEL_ACCESS_TOKEN=xxx
LINE_CHANNEL_SECRET=xxx

# Memory
MEMORY_TABLE_NAME=animitta-conversations
MAX_RECENT_TURNS=5
# Days without a message after which a person's turns and summary are gone (quoted to users in 關於; default 30)
# CONVERSATION_TTL_DAYS=30
SESSION_IDLE_HOURS=2

# Rich Menu (created by scripts/setup-richmenu.mjs)
RICH_MENU_ID=

# Alerts: failed replies and key-expiry reminders are emailed here (confirm the AWS subscription email once)
ALERT_EMAIL=
# Expiry date of ANTHROPIC_API_KEY (YYYY-MM-DD); reminders go out 7 days and 1 day before, 10:00 Taipei
ANTHROPIC_KEY_EXPIRES_ON=
